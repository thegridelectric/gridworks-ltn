[Unit]
Description=GridWorks LTN — the Leaf Transactive Node (hears its scada, bids into the market)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ltn
# Repo root as CWD so `.env` at the repo root resolves.
WorkingDirectory=/home/ltn/gridworks-ltn
ExecStart=/home/ltn/gridworks-ltn/.venv/bin/gwltn rabbit
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
