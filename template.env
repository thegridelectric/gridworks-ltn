# Copy to .env (gitignored) and fill in.
# Settings use the GWLTN_ prefix; nested fields use the __ delimiter.

# Rabbit broker URL — amqp:// for non-TLS, amqps:// for TLS. On a gated
# broker the actor's own cert, CN = its FIS principal id:
# GWLTN_RABBIT__TLS__CA_CERT_PATH=/home/ltn/.config/gridworks/ltn/certs/ca.crt
# GWLTN_RABBIT__TLS__CERT_PATH=/home/ltn/.config/gridworks/ltn/certs/ltn.crt
# GWLTN_RABBIT__TLS__PRIVATE_KEY_PATH=/home/ltn/.config/gridworks/ltn/certs/ltn.pem
GWLTN_RABBIT__URL=amqp://smqPublic:smqPublic@localhost:5672/d1__1

# This LTN's GNode alias; MUST equal the Alias in g.node.gt.json
# (default path ~/.config/gridworks/ltn/g.node.gt.json) and the LTN
# GNode of the house's layout.
GWLTN_SERVICE_ALIAS=d1.isone.me.versant.keene.beech.ltn
# GWLTN_G_NODE_PATH=/home/ltn/.config/gridworks/ltn/g.node.gt.json

# The house's two authored artifacts (defaults shown). The layout names
# the scada this LTN serves, the only scada whose traffic it hears.
# GWLTN_HARDWARE_LAYOUT=/home/ltn/.config/gridworks/ltn/hardware-layout.json
# GWLTN_OPERATIONAL_PARAMS=/home/ltn/.config/gridworks/ltn/operational-params.json
# GWLTN_DATA_PATH=/home/ltn/.local/share/gridworks/ltn

# Weather: Gwwf pulls the forecast service; Sim is a steady forecast for a bench.
GWLTN_WEATHER_SOURCE=Gwwf

GWLTN_LOG_LEVEL=INFO

# The control plane the Orchestrator tier answers to.
GWLTN_SUPER_ALIAS=d1.super1
GWLTN_TIME_COORDINATOR_ALIAS=d1.time

# The FLO GNode that answers this LTN's flo.params.
GWLTN_FLO_ALIAS=d1.flo
